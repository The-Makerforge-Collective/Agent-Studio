{
  "realm": "agent-studio",
  "enabled": true,
  "loginWithEmailAllowed": true,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "user", "description": "Default user role" },
      { "name": "admin", "description": "Administrator role" }
    ]
  },
  "clients": [
    {
      "clientId": "agent-studio-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8088/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:8088"
      ],
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "admin@agentstudio.dev",
      "email": "admin@agentstudio.dev",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin12345",
          "temporary": false
        }
      ],
      "realmRoles": ["admin", "user"]
    },
    {
      "username": "user@agentstudio.dev",
      "email": "user@agentstudio.dev",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "user12345",
          "temporary": false
        }
      ],
      "realmRoles": ["user"]
    }
  ]
