{
  "realm": "agent-studio",
  "enabled": true,
  "roles": {
    "realm": [
      { "name": "admin" },
      { "name": "editor" },
      { "name": "viewer" }
    ]
  },
  "clients": [
    {
      "clientId": "agent-studio-web",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@acme.dev",
      "firstName": "Alice",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "attributes": { "tenant": ["acme"] },
      "credentials": [{ "type": "password", "value": "alice12345", "temporary": false }],
      "realmRoles": ["admin"]
    },
    {
      "username": "bob",
      "email": "bob@acme.dev",
      "firstName": "Bob",
      "lastName": "Viewer",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "attributes": { "tenant": ["acme"] },
      "credentials": [{ "type": "password", "value": "bob12345", "temporary": false }],
      "realmRoles": ["viewer"]
    }
  ]
}
